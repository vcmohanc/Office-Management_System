PORT=5000

# MongoDB container credentials (used by both mongo and server services)
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=your_secure_mongo_password
MONGO_INITDB_DATABASE=office_manage_system

# MONGO_URI is auto-built from the credentials above in docker-compose.override.yml for local dev.
# On the production server, set this explicitly in /etc/oms/.env:
# MONGO_URI=mongodb://admin:your_secure_mongo_password@mongo:27017/office_manage_system?authSource=admin
MONGO_URI=

CLIENT_URL=
JWT_SECRET=your_jwt_secret_key
